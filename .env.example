# ---------------------------------------------------------------------------
# LeakSentinel environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# Postgres connection (matches docker-compose.yml defaults).
DATABASE_URL=postgresql+psycopg://leaksentinel:leaksentinel@localhost:5433/leaksentinel

# ---- LLM provider ----------------------------------------------------------
# Choose which provider the agent uses. One of: anthropic | groq
LLM_PROVIDER=anthropic

# Primary provider: Anthropic Claude.
ANTHROPIC_API_KEY=
# Default model when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-4-8

# Alternative provider: Groq (set LLM_PROVIDER=groq to use this instead).
GROQ_API_KEY=
# Default model when LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Auth (required) -------------------------------------------------------
# The API refuses to start without JWT_SECRET. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
# First-admin bootstrap: on first startup, if no users exist AND a password is
# set here, an admin user is created with these credentials. Leave the password
# blank to skip bootstrap (e.g. when you provision users another way).
FIRST_ADMIN_EMAIL=admin@leaksentinel.local
FIRST_ADMIN_PASSWORD=

# ---- Observability (optional) ----------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=leaksentinel
