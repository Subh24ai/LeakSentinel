# ---------------------------------------------------------------------------
# LeakSentinel environment configuration
# Copy to `.env` and fill in real values:  cp .env.example .env
# ---------------------------------------------------------------------------

# ---- Database --------------------------------------------------------------
# Postgres credentials used by the `postgres` service in docker-compose.
POSTGRES_DB=leaksentinel
POSTGRES_USER=leaksentinel
POSTGRES_PASSWORD=leaksentinel

# Connection string for host-local development (the docker-compose backend/worker
# OVERRIDE this to point at the `postgres` service on the compose network, so you
# don't need to change it here for Docker).
DATABASE_URL=postgresql+psycopg://leaksentinel:leaksentinel@localhost:5433/leaksentinel

# ---- LLM provider ----------------------------------------------------------
# Choose which provider the agent uses. One of: anthropic | groq
LLM_PROVIDER=anthropic

# Primary provider: Anthropic Claude.
ANTHROPIC_API_KEY=
# Default model when LLM_PROVIDER=anthropic
ANTHROPIC_MODEL=claude-opus-4-8

# Alternative provider: Groq (set LLM_PROVIDER=groq to use this instead).
GROQ_API_KEY=
# Default model when LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Auth (required) -------------------------------------------------------
# The API refuses to start without JWT_SECRET. The value below is a DEV default
# so `docker compose up` works out of the box — CHANGE IT IN PRODUCTION with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-jwt-secret-change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8
# First-admin bootstrap: on first startup, if no users exist AND a password is
# set here, an admin user is created with these credentials. The dev default
# below lets you log in immediately — CHANGE IT for any real deployment. Leave
# the password blank to skip bootstrap (e.g. when you provision users elsewhere).
FIRST_ADMIN_EMAIL=admin@leaksentinel.local
# Temporary password — admin must change on first login
FIRST_ADMIN_PASSWORD=changeme-admin

# ---- Observability (optional) ----------------------------------------------
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=leaksentinel
